{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Offline voice dictation",
    "longDescription": "Local speech recognition and dictation for Linux and Windows.",
    "homepage": "https://github.com/V2P-Dev/Vispeak",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/app.vispeak.desktop": "../packaging/linux/app.vispeak.desktop"
        },
        "depends": [
          "libgtk-3-0t64",
          "libgtk-layer-shell0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libasound2t64",
          "libc6 (>= 2.38)",
          "libx11-6",
          "libxtst6",
          "libxi6",
          "xdotool",
          "xclip",
          "wl-clipboard",
          "pulseaudio-utils",
          "xdg-desktop-portal"
        ],
        "section": "utils"
      },
      "rpm": {
        "files": {
          "/usr/share/applications/app.vispeak.desktop": "../packaging/linux/app.vispeak.desktop"
        },
        "depends": [
          "gtk3",
          "gtk-layer-shell",
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "alsa-lib",
          "libX11",
          "libXtst",
          "libXi",
          "xdotool",
          "xclip",
          "wl-clipboard",
          "pulseaudio-utils",
          "xdg-desktop-portal"
        ],
        "compression": {
          "type": "zstd",
          "level": 3
        }
      }
    }
  },
  "app": {
    "security": {
      "assetProtocol": {
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$APPCONFIG/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  }
}
